#!/usr/bin/env tclsh
# %renumber<^\s*test >%

source [file join [file dir [info script]] initests.tcl]

test 0 {} {
  package require Mk4tcl
} $version

# Datafiles can be larger than 2 Gb.  That takes too much to test here, but
# for a small one the same commands can be checked: they must report sizes
# and positions as integers which are not limited to 32 bits.

set f f1.dat
test 1 {mk::file end returns the size of the datafile} -body {
  file delete $f

  mk::file open db $f
  mk::view layout db.a {s:S b:B}
  for {set i 0} {$i < 50} {incr i} {
    mk::row append db.a s "row $i" b [string repeat x [expr {$i * 100}]]
  }
  mk::file commit db
  mk::file close db

  equal [file size $f] [mk::file end $f]
} -cleanup {file delete $f}

test 2 {mk::file end rejects other files} -body {
  set fd [open $f w]
  puts $fd "this is not a datafile"
  close $fd

  list [catch {mk::file end $f} msg] $msg
} -cleanup {file delete $f} -result {1 {not a Metakit datafile}}

test 3 {mk::file space lists increasing positions} -body {
  file delete $f

  mk::file open db $f
  mk::view layout db.a {s:S b:B}
  for {set i 0} {$i < 50} {incr i} {
    mk::row append db.a s "row $i" b [string repeat x [expr {$i * 100}]]
  }
  mk::file commit db

  set space [mk::file space db]
  assert [expr {[llength $space] >= 2}]
  set last -1
  foreach pos $space {
    assert [string is integer -strict $pos]
    assert [expr {$pos > $last}]
    set last $pos
  }
  # the used space ends where the datafile does
  equal [file size $f] $last
} -cleanup {mk::file close db; file delete $f}

test 4 {data survives when a datafile is reopened} -body {
  file delete $f

  mk::file open db $f
  mk::view layout db.a {b:B}
  for {set i 0} {$i < 4} {incr i} {
    mk::row append db.a b [string repeat [format %c [expr {65 + $i}]] 70000]
    mk::file commit db
  }
  mk::file close db

  mk::file open db $f -readonly
  set r {}
  for {set i 0} {$i < 4} {incr i} {
    set s [mk::get db.a!$i b]
    lappend r [string length $s] [string index $s 0] [string index $s end]
  }
  set r
} -cleanup {mk::file close db; file delete $f} -result {70000 A A 70000 B B 70000 C C 70000 D D}

# A column cannot hold more than 2 Gb.  Asking for it is an error in Tcl, it
# can be handled, and the changes which were made have to be rolled back.
# (A million million longs are never allocated, the error comes first.)
test 5 {a column which would be too large is an error, not the end} -body {
  file delete $f

  mk::file open db $f
  mk::view layout db.a {l:L}
  mk::row append db.a l 5
  mk::file commit db

  # (each long takes 8 bytes: this many would be a column of 2 Gb, one too many)
  set r [catch {mk::view size db.a 268435456} msg]
  assert $r
  assert [string match {*more than the limit*} $msg]
  equal [mk::view size db.a] 1

  # nothing can be committed now, so the file cannot get the incomplete data
  assert [catch {mk::file commit db}]
  mk::file rollback db
  equal [mk::view size db.a] 1
  equal [mk::get db.a!0 l] 5

  # and it all works again
  mk::row append db.a l 6
  mk::file commit db
  mk::file close db

  mk::file open db $f -readonly
  set r [list [mk::view size db.a] [mk::get db.a!0 l] [mk::get db.a!1 l]]
  mk::file close db
  set r
} -cleanup {catch {mk::file close db}; file delete $f} -result {2 5 6}

# A memo cannot grow beyond the limit for a column either.  Through mk::channel
# a write which would go beyond it fails, with "file too large" (it was
# "invalid argument"), and what was written before is kept: the program has
# to decide what to do with it.  This needs over 2 Gb of memory and disk, and
# runs with "make test-large" (constraint largeData).
test 6 {writing a memo beyond 2 Gb through a channel} -constraints largeData -body {
  file delete $f

  mk::file open db $f
  mk::view layout db.a {name:S m:B}
  mk::row append db.a name big

  set fd [mk::channel db.a!0 m w]
  fconfigure $fd -translation binary
  set chunk [string repeat abcdefgh [expr {8 << 20}]]
  set n 0
  set r [catch {
    while {$n < 40} {
      puts -nonewline $fd $chunk
      flush $fd
      incr n
    }
  } msg]
  catch {close $fd}
  lappend r $msg [expr {$n * [string length $chunk] < 0x80000000}]

  # what was written is all there, in whole buffers of the channel
  set size [mk::get db.a!0 -size m]
  lappend r [expr {$size > 0x7fffffff - 65536 && $size <= 0x7fffffff}]
  mk::file commit db
  mk::file close db

  mk::file open db $f -readonly
  lappend r [expr {[mk::get db.a!0 -size m] == $size}]
  set fd [mk::channel db.a!0 m]
  fconfigure $fd -translation binary
  seek $fd -8 end
  lappend r [read $fd]
  close $fd
  set r
} -cleanup {catch {mk::file close db}; file delete $f} -match glob -result {1 {error writing "*": file too large} 1 1 1 abcdefgh}

file delete $f
cleanupTests
