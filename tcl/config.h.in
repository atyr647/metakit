/* config.h.in -- copied to config.h by the TEA configure script of Mk4tcl.
 *
 * src/header.h includes "config.h".  Unlike unix/configure, the TEA configure
 * script does not write its results into this file: it passes them on the
 * command line of the compiler (DEFS in the Makefile: -DHAVE_MMAP=1 and so on)
 * and copies this file as it is.  So this file must not #undef any of them.
 * It used to have the #undef lines which autoheader writes, and they turned
 * off what configure had found, among them mmap: Mk4tcl then read datafiles
 * with stdio instead of memory-mapping them.
 */
